# Server Configuration
PORT=3001
NODE_ENV=production

# JWT signing secret — 生产环境必须设置强随机值！
# 生成方式：node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# CORS - comma separated allowed origins
ALLOWED_ORIGINS=https://angumesh.com,https://www.angumesh.com

# Frontend URL — 管理后台数据变更后，后端用它通知前端刷新 ISR 缓存
FRONTEND_URL=https://www.angumesh.com

# Shared secret for /api/revalidate — 需与前端 Next.js 服务的 REVALIDATE_SECRET 一致
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 留空则关闭按需失效，仅依赖 ISR 定期刷新
REVALIDATE_SECRET=

# ── 询盘邮件通知 ──────────────────────────────────────────────
# angumesh.com 的 MX 指向网易企业邮（hzmx01/02.mxmail.netease.com）
# SMTP_PASS 必须是「客户端授权码」：
#   网易企业邮箱 → 设置 → POP3/SMTP/IMAP → 开启 SMTP 服务 → 生成授权码
# 用邮箱登录密码会返回 535 认证失败。SMTP_PASS 留空则不发信（询盘仍入库）。
SMTP_HOST=smtp.qiye.163.com
SMTP_PORT=465
SMTP_USER=admin@angumesh.com
SMTP_PASS=
# 收件人（内部通知）。发信用 admin 管理员账号，收件仍走业务邮箱 annie
NOTIFY_EMAIL=annie@angumesh.com

# 客户自动回复：默认关闭。正文代表公司对外承诺，确认文案后再设 on
AUTO_REPLY=off

# 后台地址，用于询盘通知邮件里的「打开后台」按钮
ADMIN_URL=https://www.angumesh.com/admin
